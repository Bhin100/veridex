# ==============================================================================
# VERIDEX PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# ==============================================================================

# --- NODE ENVIRONMENT ---
NODE_ENV=production
PORT=4000

# --- DATABASE & BROKER (REQUIRED) ---
# Connection string for PostgreSQL database
DATABASE_URL="postgresql://postgres:your_secure_password@your-db-host:5432/veridex?schema=public"
# Connection string for Redis broker (BullMQ queues)
REDIS_URL="redis://:your_redis_password@your-redis-host:6379"

# --- OWNER AUTHENTICATION (REQUIRED) ---
# Symmetric signing key for JWT session tokens (Minimum 16 characters)
JWT_SECRET="generate_a_super_secure_sha256_or_aes_key_here_at_least_32_characters"
# Default single-user credentials
FOUNDER_EMAIL="founder@veridex.ai"
FOUNDER_PASSWORD="choose_a_super_secure_founder_password"

# --- TELEGRAM MINI APP (OPTIONAL) ---
# Origin link configuration for the Telegram Bot redirect Mini App
TELEGRAM_MINIAPP_ORIGIN="https://t.me/veridex_bot/app"

# --- SYSTEM OPTIONALS & LOGS (OPTIONAL) ---
LOG_LEVEL="info"
SESSION_COOKIE_NAME="veridex.sid"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SECRET_PROVIDER="env"
